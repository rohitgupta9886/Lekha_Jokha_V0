# ==============================================================================
# Lekha Jokha - Environment Configuration Template
# For Render Deployment, set these variables in the Render Dashboard Environment tab.
# NEVER commit production secrets or credentials to source control.
# ==============================================================================

# Server Network Configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# PostgreSQL Primary Database Connection URL
# On Render: Use the Internal Database URL from your Render PostgreSQL instance
# Format: postgres://username:password@dpg-xxxxxxxx-a:5432/lekhajokha_db
DATABASE_URL=postgres://lekhajokha_user:your_secure_password@localhost:5432/lekhajokha_db

# Connection Pool Settings
PG_POOL_MAX=20
PG_IDLE_TIMEOUT=30000
PG_CONNECT_TIMEOUT=10000
PG_STATEMENT_TIMEOUT=20000

# Security & CORS Configuration
# Set to your specific deployed domain (e.g. https://lekhajokha.onrender.com) or leave empty for wildcard
CORS_ORIGIN=*
RATE_LIMIT_MAX=2000

# Strict PostgreSQL enforcement (if true, fails startup if database is not reachable)
STRICT_PG=true

# AI Copilot & Voice Transcription Engine (Optional)
GEMINI_API_KEY=your_gemini_api_key_here

# Maximum Businesses Allowed per Account
MAX_BUSINESSES_PER_OWNER=5
